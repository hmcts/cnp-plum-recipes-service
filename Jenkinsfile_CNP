#!groovy

// DTSPO-36210: testing hmcts/cnp-jenkins-library#1602. Do not merge.
@Library("Infrastructure@DTSPO-36210-fortify-optional-vault-secrets") _

def type = "java"
def product = "plum"
def component = "recipe-backend"

def apiTestSecrets = [ 'plumsi-${env}' :
  [
    secret('test-client-key-store', 'TEST_CLIENT_KEY_STORE'),
    secret('test-client-key-store-password', 'TEST_CLIENT_KEY_STORE_PASSWORD'),
    secret('test-client-subscription-key', 'TEST_CLIENT_SUBSCRIPTION_KEY')
  ]
]

static LinkedHashMap<String, Object> secret(String secretName, String envVar) {
  [ $class: 'AzureKeyVaultSecret',
    secretType: 'Secret',
    name: secretName,
    version: '',
    envVariable: envVar
  ]
}

def expiresAfter = "3000-01-01"

withPipeline(type, product, component) {
  enableAksStagingDeployment()
  disableLegacyDeployment()
  enableApiGatewayTest()
  onNonPR() {
    loadVaultSecrets(apiTestSecrets)
  }
  expires(expiresAfter)

  // plumsi-aat does not hold fortify-on-demand-username/password: the scan should warn and authenticate
  // with the Jenkins fortify-on-demand-oauth credential instead of failing the build. Without a PR label
  // this exercises the enableFortifyScan() path; add enable_fortify_scan for the PR-label path.
  enableFortifyScan('plumsi-aat')

}
