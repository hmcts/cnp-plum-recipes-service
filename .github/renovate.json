{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "github>hmcts/.github//renovate/automerge-all",
    "local>hmcts/.github:renovate-config#DTSPO-35003-java-chart-lts-filter"
  ],
  "packageRules": [
    {
      "matchDatasources": [
        "docker"
      ],
      "matchPackageNames": [
        "hmctsprod.azurecr.io/helm/java"
      ],
      "versioning": "loose"
    }
  ],
  "hostRules": [
    {
      "description": "HTTPS scheme + appid/secret (matches documented pattern)",
      "matchHost": "https://hmctsprod.azurecr.io",
      "hostType": "docker",
      "username": "{{ secrets.RENOVATE_ACR_APPID }}",
      "password": "{{ secrets.RENOVATE_ACR_SECRET }}"
    }
  ]
}
